<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<title>Voice Bridge</title>
<meta name="viewport" content="width=device-width, initial-scale=1">
<link rel="icon" href="/favicon.ico" sizes="any">
<link rel="apple-touch-icon" href="/icon.png">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;500;600&family=Noto+Sans+Bengali:wght@400;500&display=swap" rel="stylesheet">
<style>
  :root {
    --ink: #0d1014;
    --panel: #151a20;
    --line: #232b34;
    --text: #e7ecf1;
    --muted: #78848f;
    --dim: #4c5761;
    --live: #47d18b;
    --warn: #e8664a;
  }
  * { box-sizing: border-box; }
  html, body {
    margin: 0; height: 100%;
    background: var(--ink);
    color: var(--text);
    font-family: "Outfit", "Segoe UI", sans-serif;
    -webkit-user-select: none; user-select: none;
    overflow: hidden;
  }
  body { display: flex; flex-direction: column; padding: 16px 18px 12px; gap: 12px; }

  header { display: flex; align-items: baseline; justify-content: space-between; gap: 8px; }
  h1 { font-size: 12px; font-weight: 500; letter-spacing: .14em; text-transform: uppercase; margin: 0; color: var(--muted); }
  .keys { font-size: 11px; color: var(--dim); letter-spacing: .04em; white-space: nowrap; }

  .stage { display: flex; flex-direction: column; align-items: center; gap: 10px; }

  .micwrap { position: relative; display: grid; place-items: center; }
  #toggle {
    position: relative; z-index: 1;
    width: 96px; height: 96px; border-radius: 50%;
    border: 1px solid var(--line); background: var(--panel);
    color: var(--muted); cursor: pointer;
    display: grid; place-items: center;
    transition: border-color .18s, color .18s, transform .12s;
  }
  #toggle:hover { border-color: #35424f; }
  #toggle:active { transform: scale(.97); }
  #toggle:focus-visible { outline: 2px solid var(--live); outline-offset: 3px; }
  #toggle svg { width: 32px; height: 32px; }
  body.live #toggle { color: var(--live); border-color: var(--live); }

  .ring {
    position: absolute; width: 96px; height: 96px; border-radius: 50%;
    border: 1px solid var(--live); opacity: 0; pointer-events: none;
  }
  body.live .ring { animation: pulse 1.9s ease-out infinite; }
  @keyframes pulse {
    from { transform: scale(1); opacity: .5; }
    to   { transform: scale(1.38); opacity: 0; }
  }
  @media (prefers-reduced-motion: reduce) { body.live .ring { animation: none; } }

  #status { font-size: 13px; color: var(--muted); min-height: 18px; text-align: center; }
  body.live #status { color: var(--live); }
  body.error #status { color: var(--warn); }

  .langs { display: flex; gap: 6px; }
  .lang {
    font-family: inherit; font-size: 12px; padding: 4px 12px; border-radius: 999px;
    background: transparent; border: 1px solid var(--line); color: var(--muted); cursor: pointer;
  }
  .lang[aria-pressed="true"] { color: var(--text); border-color: #3d4a57; background: var(--panel); }
  .lang:focus-visible { outline: 2px solid var(--live); outline-offset: 2px; }

  #target {
    font-size: 11.5px; color: var(--dim); text-align: center;
    white-space: nowrap; overflow: hidden; text-overflow: ellipsis;
    padding: 5px 8px; border: 1px solid var(--line); border-radius: 6px;
  }
  #target.bad { color: var(--warn); border-color: rgba(232,102,74,.4); }

  #preview {
    flex: 1; min-height: 0; overflow-y: auto;
    border-top: 1px solid var(--line); padding-top: 10px;
    font-family: "Noto Sans Bengali", "Outfit", sans-serif;
    font-size: 14px; line-height: 1.55; color: var(--muted);
    -webkit-user-select: text; user-select: text;
  }
  #preview .final { color: var(--text); }
  #preview:empty::before { content: "Nothing heard yet."; color: var(--dim); }
</style>
</head>
<body>

<header>
  <h1>Voice Bridge</h1>
  <span class="keys" id="keys"></span>
</header>

<div class="stage">
  <div class="micwrap">
    <span class="ring"></span>
    <button id="toggle" aria-pressed="false" aria-label="Start dictation">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round">
        <rect x="9" y="2" width="6" height="12" rx="3"/>
        <path d="M5 11a7 7 0 0 0 14 0"/>
        <path d="M12 18v4"/>
      </svg>
    </button>
  </div>
  <div id="status">Press the mic, then talk.</div>
  <div class="langs" id="langs"></div>
</div>

<div id="target">Waiting for a target window</div>
<div id="preview" aria-live="polite"></div>

<script>
(function () {
  var SR = window.SpeechRecognition || window.webkitSpeechRecognition;
  var body = document.body;
  var toggleBtn = document.getElementById("toggle");
  var statusEl = document.getElementById("status");
  var previewEl = document.getElementById("preview");
  var langsEl = document.getElementById("langs");
  var targetEl = document.getElementById("target");
  var keysEl = document.getElementById("keys");

  var config = {
    defaultLang: "bn-BD", altLang: "en-US", typeInterim: false,
    hotkeyToggle: "ctrl+alt+m", hotkeyLang: "ctrl+alt+l", target: ""
  };
  var rec = null;
  var listening = false;
  var lang = config.defaultLang;
  var restartTimer = null;
  var chain = Promise.resolve();
  var targetTitle = "";

  if (!SR) {
    setStatus("This browser has no speech engine. Use Chrome or Edge.", true);
    toggleBtn.disabled = true;
    return;
  }

  function setStatus(text, isError) {
    statusEl.textContent = text;
    body.classList.toggle("error", !!isError);
  }

  function prettyKeys(spec) {
    return spec.split("+").map(function (p) {
      p = p.trim();
      return p.charAt(0).toUpperCase() + p.slice(1);
    }).join(" ");
  }

  function showTarget(title, bad) {
    targetEl.textContent = title;
    targetEl.classList.toggle("bad", !!bad);
  }

  function post(path, payload, onResult) {
    chain = chain.then(function () {
      return fetch(path, {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify(payload)
      }).then(function (r) { return r.json(); })
        .then(function (j) { if (onResult) onResult(j); })
        .catch(function () {});
    });
    return chain;
  }

  function onTyped(res) {
    if (!res) return;
    if (res.result === "blocked" || res.result === "error") {
      showTarget(res.message || "Typing blocked", true);
    } else if (res.message) {
      showTarget("Typing into  " + res.message, false);
    }
  }

  function renderLangs() {
    langsEl.innerHTML = "";
    [config.defaultLang, config.altLang].forEach(function (code) {
      var b = document.createElement("button");
      b.className = "lang";
      b.type = "button";
      b.textContent = code;
      b.setAttribute("aria-pressed", String(code === lang));
      b.addEventListener("click", function () { setLang(code); });
      langsEl.appendChild(b);
    });
  }

  function setLang(code) {
    if (code === lang) return;
    lang = code;
    renderLangs();
    if (listening) { stop(); setTimeout(start, 180); }
    else { setStatus("Language set to " + code); }
  }

  function buildRecognizer() {
    var r = new SR();
    r.lang = lang;
    r.continuous = true;
    r.interimResults = true;
    r.maxAlternatives = 1;

    r.onstart = function () {
      body.classList.add("live");
      toggleBtn.setAttribute("aria-pressed", "true");
      toggleBtn.setAttribute("aria-label", "Stop dictation");
      setStatus("Listening in " + lang);
    };

    r.onresult = function (e) {
      var interim = "";
      for (var i = e.resultIndex; i < e.results.length; i++) {
        var result = e.results[i];
        var text = result[0].transcript;
        if (result.isFinal) {
          post("/text", { text: text, final: true }, onTyped);
          appendPreview(text);
        } else {
          interim += text;
        }
      }
      if (interim) {
        if (config.typeInterim) post("/text", { text: interim, final: false }, onTyped);
        showInterim(interim);
      }
    };

    r.onerror = function (e) {
      if (e.error === "no-speech" || e.error === "aborted") return;
      if (e.error === "not-allowed" || e.error === "service-not-allowed") {
        listening = false;
        paintStopped();
        setStatus("Microphone blocked. Allow it for this page.", true);
        return;
      }
      setStatus("Engine error: " + e.error, true);
    };

    r.onend = function () {
      // Chrome ends the session after a pause. Restart it so dictation feels
      // continuous, the same way the Voice In extension does.
      if (!listening) { paintStopped(); return; }
      clearTimeout(restartTimer);
      restartTimer = setTimeout(function () {
        try { rec.start(); } catch (err) { /* already starting */ }
      }, 250);
    };

    return r;
  }

  function paintStopped() {
    body.classList.remove("live");
    toggleBtn.setAttribute("aria-pressed", "false");
    toggleBtn.setAttribute("aria-label", "Start dictation");
    setStatus("Stopped. Press " + prettyKeys(config.hotkeyToggle) + " to dictate.");
  }

  var interimNode = null;

  function showInterim(text) {
    if (!interimNode) {
      interimNode = document.createElement("span");
      previewEl.appendChild(interimNode);
    }
    interimNode.textContent = text + " ";
    previewEl.scrollTop = previewEl.scrollHeight;
  }

  function appendPreview(text) {
    if (interimNode) { interimNode.remove(); interimNode = null; }
    var span = document.createElement("span");
    span.className = "final";
    span.textContent = text.trim() + " ";
    previewEl.appendChild(span);
    while (previewEl.childNodes.length > 60) previewEl.removeChild(previewEl.firstChild);
    previewEl.scrollTop = previewEl.scrollHeight;
  }

  function start() {
    if (listening) return;
    listening = true;
    rec = buildRecognizer();
    try {
      rec.start();
    } catch (err) {
      listening = false;
      setStatus("Could not start: " + err.message, true);
      return;
    }
    post("/state", { listening: true, lang: lang });
  }

  function stop() {
    if (!listening) return;
    listening = false;
    clearTimeout(restartTimer);
    try { rec.stop(); } catch (err) {}
    if (interimNode) { interimNode.remove(); interimNode = null; }
    paintStopped();
    post("/state", { listening: false, lang: lang });
  }

  toggleBtn.addEventListener("click", function () {
    listening ? stop() : start();
  });

  // Commands pushed from the Python side when a global hotkey fires.
  var events = new EventSource("/events");
  events.onmessage = function (e) {
    var msg = JSON.parse(e.data);
    if (msg.cmd === "toggle") { listening ? stop() : start(); }
    if (msg.cmd === "lang") { setLang(lang === config.defaultLang ? config.altLang : config.defaultLang); }
    if (msg.cmd === "target") {
      targetTitle = msg.title;
      showTarget("Typing into  " + targetTitle, false);
    }
  };

  fetch("/config")
    .then(function (r) { return r.json(); })
    .then(function (c) {
      config = c;
      lang = c.defaultLang;
      renderLangs();
      keysEl.textContent = prettyKeys(c.hotkeyToggle);
      setStatus("Press " + prettyKeys(c.hotkeyToggle) + " and talk.");
      if (c.target) { targetTitle = c.target; showTarget("Typing into  " + c.target, false); }
    })
    .catch(function () { renderLangs(); });
})();
</script>
</body>
</html>
